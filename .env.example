# Demo is the default. It makes no Twitch requests.
MODE=demo
PORT=5173

# Optional: change MODE to twitch and supply a broadcaster's user access token.
TWITCH_CLIENT_ID=
TWITCH_USER_ACCESS_TOKEN=
# Optional: used by the Twitch CLI to obtain a user token, not by the running app.
TWITCH_CLIENT_SECRET=
# Optional: one specific custom reward ID. Otherwise the exact title is matched.
TWITCH_REWARD_ID=
TWITCH_REWARD_TITLE=Request a release check
